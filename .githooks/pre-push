#!/bin/sh
# Expensive gates — these are the checks CI runs. Work lands on main
# directly rather than through PRs, so this is the last automated check
# before a change is public.
#
# Bypass with: git push --no-verify
set -eu

if ! command -v go >/dev/null 2>&1; then
	echo "pre-push: go not found — run inside 'nix develop'" >&2
	exit 1
fi

echo "pre-push: gofmt"
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
	echo "$unformatted" | sed 's/^/  /' >&2
	echo "  fix: make fmt" >&2
	exit 1
fi

# A directly imported module left marked `// indirect` passes every other
# gate here — build, vet, test and lint are all happy. Only tidy notices.
echo "pre-push: go mod tidy"
go mod tidy
if ! git diff --quiet -- go.mod go.sum; then
	git diff --stat -- go.mod go.sum | sed 's/^/  /' >&2
	echo "  go.mod/go.sum are not tidy — commit the result of 'make tidy'" >&2
	exit 1
fi

echo "pre-push: go build"
go build ./...

echo "pre-push: go vet"
go vet ./...

echo "pre-push: go test"
go test ./...

echo "pre-push: golangci-lint"
if ! command -v golangci-lint >/dev/null 2>&1; then
	echo "pre-push: golangci-lint not found — run inside 'nix develop'" >&2
	exit 1
fi
golangci-lint run ./...

echo "pre-push: ok"
