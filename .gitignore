# Nix build symlinks (flake.nix / flake.lock ARE committed)
/result
/result-*

# Binaries
/terraform-provider-pingone-aic
/pingoneaic-tf
/bin/
*.exe

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
terraform.rc

# Generated local experiment output
/generated/
/examples/**/terraform.tfstate*

# Secrets — never commit JWKs, tokens, or env files
*.jwk
*.pem
.env
.env.*
.envrc
.direnv/
.token-cache
get-token.sh

# aic CLI agent runtime state (socket, pid, log)
/.aic/

# Machine-local AI agent notes (paths to sibling checkouts etc).
# .ai/core.md IS committed; local.md is not. See .ai/local.md.example.
/.ai/local.md

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
