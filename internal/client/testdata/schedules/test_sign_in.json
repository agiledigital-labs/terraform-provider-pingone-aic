{
  "_id": "schedule/test_sign_in",
  "concurrentExecution": false,
  "enabled": true,
  "endTime": null,
  "invokeContext": {
    "numberOfThreads": 5,
    "scan": {
      "_queryFilter": "/userName eq \"david.balmain\"",
      "object": "managed/alpha_user",
      "taskState": {
        "completed": "/userName/task-completed",
        "started": "/userName/task-started"
      }
    },
    "task": {
      "script": {
        "globals": {},
        "source": "var patch = [{ \"operation\" : \"replace\", \"field\" : \"/postalCode\", \"value\" : \"2300\" }];\nopenidm.patch(objectID, null, patch);",
        "type": "text/javascript"
      }
    },
    "waitForCompletion": false
  },
  "invokeLogLevel": "info",
  "invokeService": "taskscanner",
  "managedObject": "alpha_user",
  "misfirePolicy": "fireAndProceed",
  "persisted": false,
  "recoverable": false,
  "repeatCount": 1,
  "repeatInterval": 60000,
  "schedule": "0 * * * * ?",
  "scriptProperty": "userName",
  "startTime": null,
  "type": "simple"
}